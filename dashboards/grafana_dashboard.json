{
  "title": "LLM Inference Server - Production Dashboard",
  "uid": "llm-inference-kalam5",
  "version": 1,
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["llm", "inference", "mlops", "kalam5"],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (rps)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "rate(llm_requests_total[1m])",
        "legendFormat": "req/s"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "title": "P95 Latency (ms)",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(llm_request_latency_seconds_bucket[5m])) * 1000",
        "legendFormat": "P95 ms"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 200},
              {"color": "red", "value": 500}
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "title": "Cache Hit Rate (%)",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "llm_cache_hit_rate * 100",
        "legendFormat": "hit rate %"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 30},
              {"color": "green", "value": 60}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 4,
      "title": "Error Rate (%)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "rate(llm_errors_total[5m]) / rate(llm_requests_total[5m]) * 100",
        "legendFormat": "error %"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "llm_active_requests",
        "legendFormat": "active"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 20},
              {"color": "red", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Memory Usage (MB)",
      "type": "stat",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "targets": [{
        "expr": "llm_memory_usage_mb",
        "legendFormat": "MB"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 2000},
              {"color": "red", "value": 4000}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Request Latency Over Time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(llm_request_latency_seconds_bucket[2m])) * 1000",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(llm_request_latency_seconds_bucket[2m])) * 1000",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(llm_request_latency_seconds_bucket[2m])) * 1000",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 8,
      "title": "Throughput & Cache Performance",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "llm_throughput_rps",
          "legendFormat": "Throughput (rps)"
        },
        {
          "expr": "llm_cache_hit_rate * 100",
          "legendFormat": "Cache Hit Rate (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "id": 9,
      "title": "Request Distribution by Status",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
      "targets": [
        {
          "expr": "rate(llm_requests_total{status='success'}[1m])",
          "legendFormat": "Success"
        },
        {
          "expr": "rate(llm_requests_total{status='error'}[1m])",
          "legendFormat": "Error"
        }
      ]
    },
    {
      "id": 10,
      "title": "Batch Size Distribution",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
      "targets": [{
        "expr": "rate(llm_batch_size_sum[1m]) / rate(llm_batch_size_count[1m])",
        "legendFormat": "Avg Batch Size"
      }]
    },
    {
      "id": 11,
      "title": "Drift Score Over Time",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
      "targets": [{
        "expr": "llm_drift_score",
        "legendFormat": "Drift Score ({{feature}})"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 0.2}
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Memory & CPU Over Time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "llm_memory_usage_mb",
          "legendFormat": "Memory (MB)"
        },
        {
          "expr": "llm_cpu_usage_pct",
          "legendFormat": "CPU (%)"
        }
      ]
    },
    {
      "id": 13,
      "title": "Cache Size Over Time",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
      "targets": [
        {
          "expr": "llm_cache_size",
          "legendFormat": "Cache Entries"
        },
        {
          "expr": "llm_cache_hits_total",
          "legendFormat": "Total Hits"
        },
        {
          "expr": "llm_cache_misses_total",
          "legendFormat": "Total Misses"
        }
      ]
    }
  ]
}